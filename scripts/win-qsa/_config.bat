@echo off
rem ===================================================================
rem  defaults for every other .bat in this folder, which all call this
rem  one first. do not edit this file on the test machine: put the local
rem  values in _local.bat instead, it is ignored by git.
rem  the values that differ between the 395 (vulkan) and the 3090 (cuda)
rem  come after _local.bat, from the backend of the build; a value that
rem  _local.bat sets stays. README.md describes each of them.
rem ===================================================================

rem git bash / msys ships its own find, sort and friends, and puts them ahead of the windows
rem ones on PATH. the msys find does not understand /i, so `tasklist | find /i` fails there.
rem every script in this folder runs inside setlocal, so this stays in the script
set "PATH=%SystemRoot%\System32;%SystemRoot%;%SystemRoot%\System32\Wbem;%PATH%"

rem full path to the gguf, the first shard of a split model
set "MODEL=C:\models\qwen3-next.gguf"

rem the MTP draft gguf, for the arms of 04-decode with @draft
set "SPECDRAFT="

rem plain text for 03-quality and the long prompts of 04-decode (get-wikitext.bat downloads one)
set "PPLFILE=%~dp0wikitext-2-raw\wiki.test.raw"

rem build directory, created by 00-build.bat
set "BUILD=%~dp0..\..\build-win"

rem backend for cmake. auto picks from what the machine has: nvcc or CUDA_PATH -> cuda,
rem else VULKAN_SDK or glslc -> vulkan, else a cpu only build. cuda wins when both are
rem installed. pin it instead of auto to decide here:
rem   strix halo / vulkan : -DGGML_VULKAN=ON
rem   3090 / cuda         : -DGGML_CUDA=ON
set "CMAKE_BACKEND=auto"

rem cmake generator. auto keeps the cmake default, which on windows is visual studio, and
rem switches to ninja when cuda is picked but its msbuild integration is not installed.
rem pin a name to decide here, e.g. Ninja (needs cl and ninja on PATH)
set "GENERATOR=auto"

rem how every model run loads the model
set "LOADMODE=-lm dio -lzm dio"

rem the driver frees the GPU memory of a process lazily, and a model load right after one can fail:
rem before a model run the scripts wait until the GPU memory in use stops going down (SETTLE_MARGIN,
rem SETTLE_STEP, SETTLE_MAX in README). SETTLE: seconds from the end of one model run to the start of
rem the next when the memory cannot be read
set "SETTLE=30"

if exist "%~dp0_local.bat" call "%~dp0_local.bat"

rem ===================================================================
rem  derived, no need to touch
rem ===================================================================
for %%i in ("%BUILD%") do set "BUILD=%%~fi"

rem resolve the backend. BACKEND is the short name the defaults below branch on
if /i not "%CMAKE_BACKEND%"=="auto" goto :backend_set
set "CMAKE_BACKEND="
where nvcc >nul 2>&1
if not errorlevel 1 set "CMAKE_BACKEND=-DGGML_CUDA=ON"
if defined CMAKE_BACKEND goto :backend_set
if defined CUDA_PATH set "CMAKE_BACKEND=-DGGML_CUDA=ON"
if defined CMAKE_BACKEND goto :backend_set
if defined VULKAN_SDK set "CMAKE_BACKEND=-DGGML_VULKAN=ON"
if defined CMAKE_BACKEND goto :backend_set
where glslc >nul 2>&1
if not errorlevel 1 set "CMAKE_BACKEND=-DGGML_VULKAN=ON"
:backend_set

set "BACKEND=cpu"
rem as in 00-build.bat: a replace in an undefined CMAKE_BACKEND breaks the line before its if runs
if not defined CMAKE_BACKEND goto :backend_named
if not "%CMAKE_BACKEND:GGML_VULKAN=%"=="%CMAKE_BACKEND%" set "BACKEND=vulkan"
if not "%CMAKE_BACKEND:GGML_CUDA=%"=="%CMAKE_BACKEND%" set "BACKEND=cuda"
:backend_named

rem an arm is "name [VAR=value ...] [@stable] [@draft] [tool arguments]", arms are separated by ;
rem (README.md). the lists below are the arms each script runs when _local.bat sets none
if /i "%EXTRA%"=="auto" set "EXTRA="
if /i "%BACKEND%"=="cuda" goto :cuda_defaults

rem ---- 395 / vulkan: everything on the gpu ----
if not defined EXTRA      set "EXTRA=-ngl 99"
rem accurate: the f16 matmuls with f32 accumulators instead of int8 coopmat and f16 accumulators. glu0: the fused
rem gate/up/swiglu of the experts at any size, the test cases are below the 2048 tokens it waits for by default
rem notile: the medium int8 tile on the dense matmuls, as before 07.10 (the 64x128 tile is the default since then)
rem glu0 also covers the 32x64 tile of the fused gate/up (the default since 07.10): its 200-token cases take it
rem 09.10: accurate, glu0 and notile passed every op on 08.10 and their defaults are settled (07.10); only default
rem runs. GGML_VK_INT_COOPMAT=0 GGML_VK_F16ACC=0 / GGML_VK_MMID_GLU_MIN_TOKENS=0 / GGML_VK_INT_LARGE_TILE=0 still work
rem f16reg (10.10): the experts' prefill matmuls on mul_mmid_f16reg.comp (GGML_VK_MMID_F16REG=1, off by default): f16
rem coopmat with the 4/5/8-bit codes decoded into the A fragments, after coopmat_a_probe.comp at device init. the Mac
rem ran it only emulated (no matrix cores there), so 01 checks the coopmat path on the matmul_id ops (the fused gate/up
rem at any size, GGML_VK_MMID_GLU_MIN_TOKENS=0, so the small cases take it too)
rem 11.10: f16reg passed every matmul_id op on the 395 and is the default on RDNA3 since then; glu0 runs the fused
rem gate/up at any size (its small cases take it too), int8 the int8 path (GGML_VK_MMID_F16REG=0)
rem 01 of the run of 12.10 night: only the sparse attention, with the new paths. union (GGML_VK_FA_UNION=1, off by default): a tile of
rem 4 tokens x 12 heads over the union of their selections (flash_attn_union.comp); the Mac ran it only emulated (53/53,
rem 12 cases on the path, Bc 64 and 32), so 01 checks the coopmat path here; union32 with 32 list slots per step
if not defined RUN_CHECK   set "RUN_CHECK=1"
if not defined CHECKOPS    set "CHECKOPS=FLASH_ATTN_EXT n_kv_max=[1-9]"
if not defined CHECKARMS   set "CHECKARMS=default;spl8 GGML_VK_FA_SPARSE_SPLIT=8;union GGML_VK_FA_UNION=1;union32 GGML_VK_FA_UNION=1 GGML_VK_FA_UNION_BC=32"
if not defined CHECKARMS  set "CHECKARMS=default;glu0 GGML_VK_MMID_GLU_MIN_TOKENS=0 @o=MUL_MAT_ID,MUL_MAT_ID_FUSION,MUL_MAT_VEC_FUSION;int8 GGML_VK_MMID_F16REG=0 GGML_VK_MMID_GLU_MIN_TOKENS=0 @o=MUL_MAT_ID,MUL_MAT_ID_FUSION,MUL_MAT_VEC_FUSION"
rem nofusion: the same math with other rounding, it shows how far rounding alone moves the model. upstream: the
rem upstream qwen4exp and its QSA memory instead of the fork's copies (LLAMA_UPSTREAM, src/fork/llama-fork.h); it
rem loads the PLE table whole if that version does not read it lazily, a FAIL on memory is then expected
rem 08.10: nolid (no lightning indexer) mean KLD 0.01575 against 0.01594, inside the spread of nofusion; since 09.10
rem the default takes the indexer for up to 64 tokens only, so at -ub 2048 it is the nolid path
rem 08.10: accurate (no int8 coopmat, f32 acc) mean KLD 0.01404 against 0.01594: the known price of the int8 path, the
rem arm is off. 09.10: pool32 (QSA key pool in f32, LLAMA_QSA_POOL_F32) KLD 0.01572 against 0.01575 of the f16 default,
rem the arm is off
rem 10.10 evening: f16reg (the experts on f16 activations, the default since 11.10) KLD 0.015735 against 0.016057 of
rem the int8 path (nofusion 0.016073), same top 96.06 against 95.97 percent. int8: the int8 path (GGML_VK_MMID_F16REG=0)
if not defined QARMS      set "QARMS=default;nofusion GGML_VK_DISABLE_FUSION=1 GGML_VK_DISABLE_GRAPH_OPTIMIZE=1;upstream LLAMA_UPSTREAM=qwen4exp;int8 GGML_VK_MMID_F16REG=0"
rem the server setup of models.ini: an agent turn is a prompt of one ubatch below 4096 tokens
if not defined DECARGS    set "DECARGS=-fit off -b 4096 -ub 4096"
rem stable (off since 10.10): the server of the tag, its TG, PP and compute buffers (DECGREP) next to the current ones. 07.10: a short
rem prompt 0.66 s instead of 1.8 s once the host read of the context checkpoints went through cached memory (stable:
rem 1.7 s), the 2541-token prompt 697 t/s against 443 of stable, TG 27.2 against 26.7, with --spec-auto 37.6
rem none logs the gpu time of the graphs and the gpu idle time between them (GGML_VK_GRAPH_TIMING, two timestamps per
rem graph). 07.10: one decode step every 36.45 ms, the gpu busy for 35.13 of them, idle 4 percent: TG is gpu time
rem 09.10, mtp3qsa (LLAMA_MTP_QSA=1, the MTP block as a QSA layer) against the dense mtp3: the same drafts at prefix 0;
rem at a 500000-character prefix (118K tokens) acceptance 0.388 against 0.440, TG 27.61 against 29.41, the prompt
rem 175 s against 210 s. the arm is off. since 09.10 the draft context attends for its output rows only while it
rem catches up over a prompt (LLAMA_MTP_ROWS_ALL=1: every row): mtp3 at the prefix 705 t/s against 560, the 118K
rem prompt 165.5 s against 210, TG 29.34 against 29.41. the prefix pass is off (about 30 minutes per arm)
rem 11.10: none 27.28 (the 2541-token prompt 826.6 t/s against 753.6), auto 38.44, mtp3 FAIL: its load stopped in the
rem MTP head right after auto (as on 08.10, the driver frees the memory of the server before lazily). serve() now
rem tries again when the log stops growing for DECSTALL seconds (240). the compute buffer went 7905 -> 8121 MiB with
rem the non-matmul work of 10.10: the attention gate sigmoid and the GDN norm gate go into the graph earlier and later
rem now, so that the q projection and the gate live shorter (check the buffer size lines)
rem 11.10 (3c980c064): compute buffer 8121 -> 8025 MiB; none 27.33, mtp3 32.43 (third try), auto FAIL (three tries).
rem over 06.10-11.10 the MTP head load stopped right after its buffer allocation in 12 of 43 server starts here (0 of
rem 43 on the 3090), also 30 s after the previous server and on the first try: not the memory of the previous process.
rem the load is all or nothing (0.56-0.83 s or never). the loader now logs the step it stopped in ("no progress for
rem 15 s in ...", src/fork/llama-load-watch-fork.h), 04 puts it into the FAIL line
rem 11.10 evening (5ed5cfe1a): none 27.53, swap0 27.63, auto 36.90, mtp3 33.16 (third try). both mtp3 stops: "no
rem progress for 16 s in upload of blk.48.ffn_down_exps.weight, chunk 0", the first write into the freshly allocated
rem buffer of the head. with MTP the device buffers came to 98757 MiB, over the 96 GiB of dedicated memory (114507 MiB
rem = 98304 dedicated + 16203 shared), and the MTP context held its dense KQ mask (n_ctx x n_ubatch f16, 2 GiB) both in
rem its device compute buffer (2800 MiB) and pinned on the host (2248 MiB). the MTP context takes -ub 1024 now
rem (LLAMA_MTP_UBATCH, 0 = the target's): on the test model 580/532 -> 145/133 MiB at -c 65536, the draft head
rem probabilities the same in all cycles; here about 700/560 MiB expected, 96.7 GB of device buffers.
rem mtpub0: the MTP context with the -ub of the target (before 11.10 evening), the buffer lines and the speed
rem 12.10 (TG of the summary, then os / db / code / repeat): none 27.56; auto (MTP + ngram-mod, cap 6) 36.87, 30.8 /
rem 36.1 / 35.0 / 51.8; automtp (MTP, cap 6) 35.87, 30.8 / 32.4 / 38.7 / 44.8; automtp3 (MTP, cap 3) 37.43, 32.2 / 32.4 /
rem 39.7 / 50.5; mtp3 33.43; mtpub0 33.45 with the MTP context at 2800/2248 MiB against 700/562 (no head stop in 5
rem starts, the first auto try stopped in the main model allocation, no watchdog line). the cap 6 loses to 3 (verify
rem 7.7 against 6.5 ms per token, recurrent state 788 against 450 MiB): --spec-auto takes the cap 3 since 12.10.
rem ngram-mod: +16 percent on the repeated text at the cap 6, the rest within the text noise (texts diverge at 1.0).
rem since 12.10 --spec-auto adds no ngram-mod (the user's call after the 3090 run): auto is MTP at the cap 3, as
rem automtp3 was
rem maskdense (12.10): LLAMA_QSA_MASK_POS=0, the QSA mask values read out of the dense KQ mask as before. the default
rem takes them from the cell and token positions (log(1 - step(cell - token))) and never builds the dense mask,
rem n_kv x ubatch f16 pinned on the host plus its copy on the device (2 GiB each at 262144 x 4096; test model at
rem -c 16384 -ub 4096: both compute buffers -128 MiB, logits and server output the same). needs -np 1 or one sequence
rem per ubatch: the reserve of a unified cache with several slots keeps the dense mask
rem lid64 (12.10): LLAMA_QSA_LID_TOKENS=64, a prompt scores the indexer blocks with a matmul per head (fused into
rem MUL_MAT_HEADSUM, but the graph still reserved the head scores, two of 1 GiB) and an f32 bias, as before. the default
rem takes LIGHTNING_INDEXER at every size, Vulkan runs a prompt of it on the same fused matmul with the f16 mask as the
rem bias (ggml_vk_fork_lid_headsum; 4-head test model: compute buffers -4 MiB each side at -c 4096 -ub 2048, KLD 0)
rem 12.10 afternoon (9519cec3d), compute buffers (device / pinned host, MiB): lid64 5979 / 1228 (11.10: 8025 / 3275,
rem the mask from positions took -2 GiB each side), default 10495 / 716, maskdense 12542 / 2763. the lightning indexer
rem took +4.5 GiB: reached only through the attention, its selection came after the -inf fill of the mask, so the 1
rem GiB block scores and the 2 GiB mask were alive at once; auto stopped three times in the MTP head load ("upload of
rem blk.48.ffn_down_exps.weight, chunk 0"). the selection and the mask values go into the graph first now (test model
rem at -c 65536 -ub 4096: 973 -> 689 MiB, against 813 of lid64; KLD 0). TG: none 27.25, maskdense 35.89, lid64 36.29.
rem bench: the REPEAT of the -inf took 192 ms at 122880 against 49 of the FILL before (index math per element): a
rem one-element REPEAT runs as a fill on Vulkan and CUDA now. PP default 933.3 / 750.0, maskdense 926.8 / 747.9,
rem lid64 948.0 / 763.6 at 0 / 122880
rem nopf: LLAMA_PLE_PREFETCH=0, the PLE rows of each ubatch gathered when its inputs are set, in series with the
rem graphs (170-178 ms of a 4096-token ubatch here). the default gathers the next ubatch's rows while the current one
rem computes, so only a prompt longer than a ubatch shows it: the 500000-character prefix (118K tokens, ~30 minutes
rem per arm). maskdense is off
rem 12.10 evening (a15): auto compute buffer still 10495 MiB against 5979 of lid64 (the order fix did not reach the
rem real model, the test model shows no such growth), and lid64 faster: bench PP 949.8 / 784.7 against 925.6 / 746.8,
rem TG 28.47 / 25.43 against 27.32 / 24.54, server auto 36.48 against 38.70. the GPU time is the same in the profile
rem (prompt at 122880 4931 ms, the REPEAT fill 52 ms now against 192), so likely the device memory: model 78056 + KV
rem 7024 + compute 10495 is at the 96 GiB of dedicated memory. GGML_ALLOC_PEAK=1 logs what fills each compute buffer at
rem its peak (ggml/src/fork/ggml-alloc-peak-fork.inc). nopf: the 120K prompt 770.3 against 772.1 of auto, no gain: the
rem server calls decode per -b batch, and with -b = -ub there is no next ubatch inside a call to gather ahead for.
rem b16k: -b 16384, four ubatches per call. the indexer default is back to 64 tokens on Vulkan (lid64 above);
rem lidall: LLAMA_QSA_LID_TOKENS=1000000, the lightning indexer at every size, for its alloc peak line.
rem the +4.5 GiB with the lightning indexer in the prompt (08.10 12522 against 7945, 12.10 10495 against 5979) followed
rem the upstream merge that brought the op, and is fragmentation: ggml-alloc plans the compute buffer in chunks of the
rem Vulkan suballocation block (1 GiB) and the chunks peak one by one, around a 2 GiB mask and 1 GiB scores. the 4-head
rem test model at 262144 x 4096: 5312 MiB for 2074 MiB alive with 1 GiB chunks, 3264 with 2 GiB (the 395 allows 2 GiB
rem per allocation). the fork takes the device limit since 12.10 night; sub1g: GGML_VK_SUBALLOC_UPSTREAM=1, 1 GiB
rem the run of 12.10 night is a short one (the user: only what is needed, the focus is the depth): no 01/03 (kernels
rem and numbers unchanged), bench at 0 and 122880, profile at 122880, decode: the buffers (none, auto with MTP, lidall,
rem sub1g) and b16k at the 118K prompt
if not defined DECARMS    set "DECARMS=none @p=0;auto @draft --spec-auto @p=0;b16k @draft --spec-auto -b 16384 @p=500000;lidall LLAMA_QSA_LID_TOKENS=1000000 @draft --spec-auto @p=0;sub1g GGML_VK_SUBALLOC_UPSTREAM=1 @draft --spec-auto @p=0"
if not defined RUN_QUALITY set "RUN_QUALITY=0"
if not defined BENCHDEPTHS set "BENCHDEPTHS=0,122880"
if not defined BENCHSMALL  set "BENCHSMALL=0"
if not defined GGML_ALLOC_PEAK set "GGML_ALLOC_PEAK=1"
if not defined DECPREFIX  set "DECPREFIX=0 500000"
