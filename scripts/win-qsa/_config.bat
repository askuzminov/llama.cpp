@echo off
rem ===================================================================
rem  defaults for every other .bat in this folder, which all call this
rem  one first. do not edit this file on the test machine: put the local
rem  values in _local.bat instead, it is ignored by git.
rem ===================================================================

rem full path to the gguf
set "MODEL=C:\models\qwen3-next.gguf"

rem plain text file for the quality runs (get-wikitext.bat downloads one)
set "PPLFILE=%~dp0wikitext-2-raw\wiki.test.raw"

rem build directory, created by 00-build.bat
set "BUILD=%~dp0..\..\build-win"

rem backend selection for cmake.
rem   strix halo / vulkan : -DGGML_VULKAN=ON
rem   3090 / cuda         : -DGGML_CUDA=ON
set "CMAKE_BACKEND=-DGGML_VULKAN=ON"

rem arguments added to every model run.
rem   strix halo, everything on the gpu : -ngl 99
rem   3090 + i9, moe experts on the cpu : -ngl 99 -ncmoe 30
set "EXTRA=-ngl 99"

rem how the weights are loaded. dio = unbuffered reads, none = read into memory without
rem mmap, auto = let llama.cpp pick (mmap). lazy mode stays on: it saves both time and ram.
rem -lzm dio reads the rows of the PLE table through an own block cache instead of the page
rem cache; 11-ple-cache.bat compares the two before it is worth putting here
set "LOADMODE=-lm dio -lzm on"

rem пары "-lm -lzm" для 10-load-time.bat, по одной загрузке модели на прогон. ленивый
rem тензор читается через mmap, а отображение файла заставляет windows согласовывать с
rem page cache каждое unbuffered чтение того же файла, по одному. поэтому важен и набор,
rem и порядок: сначала варианты без отображения, иначе следующий прогон читает файл уже
rem прогретым. "dio auto" проверяет забытый -lzm: порог auto 4 GiB, таблица PLE больше,
rem значит auto должен дать то же, что и on
set "LOADVARIANTS="dio dio" "dio off" "dio auto" "dio on" "none on" "mmap on""
set "LOADREPS=2"

rem how many times llama-bench repeats each measurement. llama-bench warms up before
rem every one of them, so a single repeat is already stable enough for the prefill
rem sweep; raise it only when two runs disagree
set "REPS=1"

rem prompt length and depths of the prefill sweep
set "NPROMPT=2048"
set "DEPTHS=0,32768,65536,122880"
set "UBATCH=512,2048"

rem arms swept by 04, 06 and 07, one model load each. 1 is the gather
rem path: the kernel walks the list of cells the tile can see instead of all of KV. 0 is the
rem plain dense kernel. the selection is the same in both, so this only moves speed
set "FAVARIANTS=1 0"

rem context and chunk count of the quality runs. the budget is a fixed ~513 blocks, so at a
rem short context it already covers most of the cache and the indexer is bypassed. keep the
rem context well above the budget or the numbers mean nothing
set "QCTX=32768"
set "QCHUNKS=4"

rem the depth 07-perf-logger.bat measures at
set "PERFDEPTH=64000"

rem context llama-server is started with by 14-server.bat. the sweeps above stay shallow to
rem keep a research run cheap, the server does not have that reason: 262144 is the trained
rem context of qwen4exp, 0 takes it from the model
set "SRVCTX=262144"
set "SRVARGS=--host 127.0.0.1 --port 8080"

rem seconds to wait between two model loads in 07, 10 and 11. the model fills the gpu almost
rem completely and the driver frees it lazily, so a run started right after the previous one
rem dies in vkAllocateMemory
set "SETTLE=30"

rem PLE row cache settings compared by 11-ple-cache.bat, one model load each.
rem a variant is "budgetMiB readers blockKiB blocksPerRequest", 0 = leave at the default.
rem the default sweep is the reader count, because that is the read queue depth: if the
rem time does not fall as it grows, the requests are serialized somewhere
set "PLEVARIANTS="2048 1 4 64" "2048 4 4 64" "2048 16 4 64" "2048 32 4 64""

rem what 13-disk-iops.bat asks diskspd for, one run each. a variant is
rem "blockKiB queueDepth threads"; 4 KiB is the row cache block, the 256 KiB run shows the
rem bandwidth ceiling of the disk. the row cache issues one blocking read per reader thread,
rem so "4 1 8" and "4 1 32" are its own pattern, and "4 8 4" / "4 32 4" are what the same
rem queue depth gives when one thread keeps several requests in flight
set "DISKVARIANTS="4 1 1" "4 1 8" "4 1 32" "4 8 4" "4 32 4" "256 32 4""
set "DISKSECS=15"

rem what 12-ple-real.bat compares on real text, one model load each. a variant is
rem "budgetMiB blockBytes", 0 = leave at the default
set "PLEREALVARIANTS="0 0" "8 0" "1024 0""
set "PLECHUNKS=16"

rem what run-all.bat runs, 1 = run, 0 = skip. all of them run by default: a full sweep
rem takes hours, so set the ones you do not need to 0 in _local.bat. 14-server is not a
rem measurement and is never called from run-all
rem   00 - configure and build, a failed build stops the run
set "RUN_BUILD=1"
rem   01 02 03 04 - correctness and prefill speed, the point of the folder
set "RUN_PREFILL=1"
rem   05 - perplexity, run-all downloads the wikitext text if it is missing
set "RUN_QUALITY=1"
rem   06 - kl divergence, needs about 10 GB of disk
set "RUN_KL=1"
rem   07 09 10 - per-op timings, buffer allocation, load time
set "RUN_TIMING=1"
rem   08 - model diagnostics, useful when the model refuses to load
set "RUN_DIAG=1"
rem   11 12 - PLE row cache (-lzm dio) against lazy mmap, on random tokens and on real
rem           text; one model load per variant, so both are slow
set "RUN_PLE=1"
rem   13 - raw disk IOPS behind -lzm dio, needs diskspd (downloaded on first run)
set "RUN_DISK=1"

rem ===================================================================
rem  machine-specific overrides. _local.bat is not tracked by git, so
rem  keeping MODEL and the backend there stops `git pull` from colliding
rem  with edits to this file. it runs after the defaults above and before
rem  anything derived from them. see _local.example.bat
rem ===================================================================
if exist "%~dp0_local.bat" call "%~dp0_local.bat"

rem ===================================================================
rem  derived, no need to touch
rem ===================================================================
for %%i in ("%BUILD%") do set "BUILD=%%~fi"

rem multi-config generators (msvc) put the binaries in bin\Release, single-config in bin
set "BIN=%BUILD%\bin\Release"
if not exist "%BIN%" set "BIN=%BUILD%\bin"

set "LOGS=%~dp0logs"
if not exist "%LOGS%" mkdir "%LOGS%"

for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd-HHmmss"') do set "TS=%%i"
