#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_clustered : require
#ifndef EMULATE_DOT
#extension GL_EXT_integer_dot_product : require
#endif

// fork: MUL_MAT_ID of up to 8 tokens against q8_1 activations (decode and the draft checks of the experts), in place
// of mul_mat_vecq.comp with MUL_MAT_ID (ggml_vk_fork_mmv_id). A workgroup is one subgroup; it takes WG_SIZE / LPR
// rows of one expert for every token that routed to it:
// - the workgroup of (row block, slot s, token t) takes expert e = ids[t][s]. When an earlier token also took e it
//   ends: the workgroup of that token computes both, so an expert that the tokens of a draft check share is read
//   once. An expert twice in one token's ids (the zero slot of the MoE cache) leaves every slot its own workgroup;
// - LPR lanes take a row: lane l reads the chunks l, l + LPR, ... of the row (q4_K: 16 bytes of codes, the low and
//   the high nibbles are 16 codes of two sub-blocks; q5_1: a block of 32 codes), MAXR chunks (rounds) at a time;
// - no load sits under a condition the compiler cannot fold: the addresses of rounds past the row are clamped into it
//   and their sums multiplied by 0. A load under a runtime branch is waited for inside the branch (the AMD compiler
//   also moves the decode of a loaded word into the branch of its load), so each round would wait in turn;
// - the weights of all rounds and the activations of the first token are loaded together, the decode follows; every
//   other token of the workgroup takes one more round of activation loads (tokens in a compact list, a uniform
//   branch each). The AMD scheduler still puts the first use of each round's words right after its loads (a wait a
//   round); FENCE adds a branch that is never taken (fusion_flags is never all ones) and reads every word of the pass,
//   so all loads stay before it;
// - the sums of a row go through its lanes by clustered adds; the fused MUL by the routing weights reads them as
//   [token * nei0 + slot] at any token count.
// One dispatch for all tokens (the upstream shader is dispatched once per token).
//
// Defines: DATA_A_Q4_K or DATA_A_Q5_1, LPR (lanes per row: q4_K a multiple of 8), EMULATE_DOT (the 4-byte dot
// without GL_EXT_integer_dot_product, for devices without it).

layout(constant_id = 0) const uint WG_SIZE = 32;   // the subgroup size, the host requires full subgroups of it
layout(constant_id = 1) const uint MAXR = 5;       // rounds of a lane loaded at once (at most 8)
layout(constant_id = 2) const uint FENCE = 1;      // the never-taken branch that keeps the loads of a pass together (0: none)

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define NT 8     // tokens at most (the host checks ids->ne[1])
#define NS 16    // slots of a token at most (the host checks ids->ne[0])

layout(push_constant) uniform parameter {
    uint ncols;            // K
    uint nrows;            // rows of an expert (M)
    uint expert_stride;    // blocks of one expert's matrix (q4_K superblocks, q5_1 blocks)
    uint ne11;             // activation rows of a token: 1 (the slots share it) or nei0 (one a slot)
    uint nei0;             // slots of a token
    uint nei1;             // tokens
    uint nbi1;             // ids of a token, in ints
    uint fusion_flags;     // 4: times data_fuse0[token * nei0 + slot] (MAT_VEC_FUSION_FLAGS_SCALE0)
    uint stride_d;         // dst elements of a slot
    uint batch_stride_d;   // dst elements of a token
} p;

#if defined(DATA_A_Q4_K)
layout(binding = 0) readonly buffer A { uvec4 data_a[]; };   // a superblock: (d, dmin), scales, then 8 x 16 bytes of codes
#elif defined(DATA_A_Q5_1)
layout(binding = 0) readonly buffer A { uvec2 data_a[]; };   // a block: ((d, m), qh), then 2 x 8 bytes of codes
#else
#error unsupported type
#endif
// block_q8_1_x4 (the 4 (d, sum) pairs, then 4 x 32 code bytes) as 16-byte words, and its pairs as 8 and 4 bytes
layout(binding = 1) readonly buffer B   { uvec4 data_b[]; };
layout(binding = 1) readonly buffer B64 { uvec2 data_b64[]; };
layout(binding = 1) readonly buffer B32 { uint  data_b32[]; };
layout(binding = 2) writeonly buffer D { float data_d[]; };
layout(binding = 3) readonly buffer Fuse0 { float data_fuse0[]; };
layout(binding = 5) readonly buffer IDS { int data_ids[]; };

#ifdef EMULATE_DOT
int dot4(const uint a, const uint b) {
    const int ia = int(a);
    const int ib = int(b);
    return bitfieldExtract(ia,  0, 8) * bitfieldExtract(ib,  0, 8) + bitfieldExtract(ia,  8, 8) * bitfieldExtract(ib,  8, 8) +
           bitfieldExtract(ia, 16, 8) * bitfieldExtract(ib, 16, 8) + bitfieldExtract(ia, 24, 8) * bitfieldExtract(ib, 24, 8);
}
#else
int dot4(const uint a, const uint b) {
    return dotPacked4x8EXT(int(a), int(b));
}
#endif

int dot16(const uvec4 a, const uvec4 b) {
    return dot4(a.x, b.x) + dot4(a.y, b.y) + dot4(a.z, b.z) + dot4(a.w, b.w);
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint s   = gl_WorkGroupID.y;
    const uint t   = gl_WorkGroupID.z;

    const uint RPW = WG_SIZE / LPR;
    const uint l   = tid % LPR;
    const uint row = gl_WorkGroupID.x * RPW + tid / LPR;
    // rows past the end compute the last row again and store nothing
    const uint rowc = min(row, p.nrows - 1);

    const int e_id = data_ids[t * p.nbi1 + s];
    if (e_id < 0) {
        // a skipped slot: its rows are zero
        if (l == 0 && row < p.nrows) {
            data_d[t * p.batch_stride_d + s * p.stride_d + row] = 0.0;
        }
        return;
    }

    // the slot of e in each token: lane j looks through the ids of token j (lanes past the tokens read the last one
    // and count nothing; the loads go out together)
    uint found = 0;
    uint nfound = 0;
    if (p.nei1 > 1) {
        const uint base = min(tid, p.nei1 - 1) * p.nbi1;
        [[unroll]] for (uint k = 0; k < NS; ++k) {
            const int v = data_ids[base + min(k, p.nei0 - 1)];
            if (tid < p.nei1 && k < p.nei0 && v == e_id) {
                found = k + 1;
                nfound++;
            }
        }
    }
    // the tokens of the workgroup (tmask) and the slot + 1 of e in each (sl)
    uint sl[NT];
    uint tmask = 0;
    if (subgroupAny(nfound > 1)) {
        // e twice in some token: no sharing, each slot its own workgroup
        [[unroll]] for (uint j = 0; j < NT; ++j) {
            sl[j] = j == t ? s + 1 : 0;
        }
        tmask = 1u << t;
    } else {
        [[unroll]] for (uint j = 0; j < NT; ++j) {
            sl[j] = j == t ? s + 1 : subgroupBroadcast(found, j);
            if (sl[j] != 0) {
                tmask |= 1u << j;
            }
        }
        // an earlier token took e: its workgroup computes this one too
        if ((tmask & ((1u << t) - 1u)) != 0) {
            return;
        }
    }

    // the k-th token of the workgroup: its index, the slot of e in it, its activation row (past the count: the
    // workgroup's own token, never used)
    const uint cnt      = bitCount(tmask);
    const bool per_slot = p.ne11 != 1;
    uint tok[NT];
    uint slt[NT];
    uint brow[NT];
    uint mrest = tmask;
    [[unroll]] for (uint k = 0; k < NT; ++k) {
        const uint j = mrest != 0 ? uint(findLSB(mrest)) : t;
        mrest &= mrest - 1u;
        uint sj = s + 1;
        [[unroll]] for (uint i = 0; i < NT; ++i) {
            if (i == j) {
                sj = sl[i];
            }
        }
        tok[k]  = j;
        slt[k]  = sj - 1;
        brow[k] = j * p.ne11 + (per_slot ? sj - 1 : 0);
    }

    const uint e    = uint(e_id);
    const uint nblk = p.ncols / 32;   // q8_1 blocks of an activation row

    float acc[NT];
    [[unroll]] for (uint k = 0; k < NT; ++k) {
        acc[k] = 0.0;
    }

    // a round I of a lane: LOAD_A its weights, LOAD_B(K, I) the activations of the K-th token for it, DEC_A the decode
    // of the weights that the tokens share, COMP(K, I) the sum of the K-th token. Variables named by constants (an
    // array indexed in a loop stays an array until the driver unrolls it); I < MAXR folds at specialization
#if defined(DATA_A_Q4_K)
    const uint nsb    = p.ncols / 256;
    const uint SBR    = LPR / 8;                 // superblocks a round
    const uint nround = (nsb + SBR - 1) / SBR;
    const uint c      = l % 8;                   // the chunk of the superblock: sub-blocks 2jp and 2jp + 1, half hh
    const uint sbl    = l / 8;                   // the superblock of the lane in a round
    const uint jp     = c / 2;
    const uint hh     = c % 2;
    const uint arow   = e * p.expert_stride + rowc * nsb;
    // get_scale_min_k4: sub-blocks 0-3 take the low 6 bits of scales bytes 0-3 (scale) and 4-7 (min), 4-7 the nibbles
    // of bytes 8-11 and the top 2 bits of bytes 0-3 (scale) and 4-7 (min); sub-block 2jp + u sits at byte
    // (2jp + u) % 4 of each scales word. The two forms by masks and shifts of the lane (jp >= 2: the top 2 bits
    // moved to bits 4-5 and a nibble of bytes 8-11 added), not a select: the AMD compiler turns that select into
    // divergent branches, and the load of each round's head then waits right before its branch
    const uint sh0   = 8 * ((2 * jp) % 4);
    const uint sh1   = sh0 + 8;
    const uint hi_m  = 0u - (jp >> 1);           // all ones for sub-blocks 4-7
    const uint m6    = 0x3Fu ^ (hi_m & 0xFFu);   // 0x3F, or 0xC0 (the top 2 bits)
    const uint m6s   = (jp >> 1) * 2;            // 0, or 2 (bits 6-7 to bits 4-5)
    const uint mnib  = hi_m & 15u;               // 0, or 15 (the nibble of bytes 8-11)
    // blocks 2jp and 2jp + 1 of a superblock: nblk is a multiple of 8, so they are the inner blocks (jp % 2) * 2 and
    // + 1 of one x4 group; their (d, sum) pairs are its 8-byte word jp % 2
    const uint bq_off = 1 + (jp % 2) * 4 + hh;

#define LOAD_A(I) \
    uint sb##I; float kp##I; uvec4 hd##I, qv##I; \
    if (I < MAXR) { \
        const uint sbi = (i0 + I) * SBR + sbl; \
        sb##I = min(sbi, nsb - 1); \
        kp##I = sbi < nsb ? 1.0 : 0.0; \
        hd##I = data_a[(arow + sb##I) * 9]; \
        qv##I = data_a[(arow + sb##I) * 9 + 1 + c]; \
    }
#define LOAD_B(K, I) \
    uvec4 bq0_##I, bq1_##I; uvec2 bds_##I; \
    if (I < MAXR) { \
        const uint gi = ((brow[K] * nblk + sb##I * 8 + 2 * jp) / 4) * 9; \
        bq0_##I = data_b[gi + bq_off]; \
        bq1_##I = data_b[gi + bq_off + 2]; \
        bds_##I = data_b64[gi * 2 + (jp % 2)]; \
    }
#define DEC_A(I) \
    float dsc0_##I, dsc1_##I, dmn0_##I, dmn1_##I; \
    if (I < MAXR) { \
        const vec2 dm = unpackHalf2x16(hd##I.x) * kp##I; \
        const uint sc0 = (((hd##I.y >> sh0) & m6) >> m6s) | ((hd##I.w >> sh0) & mnib); \
        const uint sc1 = (((hd##I.y >> sh1) & m6) >> m6s) | ((hd##I.w >> sh1) & mnib); \
        const uint mn0 = (((hd##I.z >> sh0) & m6) >> m6s) | ((hd##I.w >> (sh0 + 4)) & mnib); \
        const uint mn1 = (((hd##I.z >> sh1) & m6) >> m6s) | ((hd##I.w >> (sh1 + 4)) & mnib); \
        dsc0_##I = dm.x * float(sc0); \
        dsc1_##I = dm.x * float(sc1); \
        /* each half of a sub-block takes half of the block sum of the activations, the two lanes of the halves make */ \
        /* it whole (as mul_mat_vecq.comp) */ \
        dmn0_##I = 0.5 * dm.y * float(mn0); \
        dmn1_##I = 0.5 * dm.y * float(mn1); \
    }
#define COMP(K, I) \
    if (I < MAXR) { \
        const uvec4 lo  = qv##I & 0x0F0F0F0Fu; \
        const uvec4 hi  = (qv##I >> 4) & 0x0F0F0F0Fu; \
        const vec2  ds0 = unpackHalf2x16(bds_##I.x); \
        const vec2  ds1 = unpackHalf2x16(bds_##I.y); \
        acc[K] += dsc0_##I * ds0.x * float(dot16(lo, bq0_##I)) + dsc1_##I * ds1.x * float(dot16(hi, bq1_##I)) - \
                  dmn0_##I * ds0.y - dmn1_##I * ds1.y; \
    }
// every word round I loaded (weights and the first token's activations), for the FENCE branch
#define TOUCH(K, I) \
    if (I < MAXR) { \
        const uvec4 t4 = hd##I ^ qv##I ^ bq0_##I ^ bq1_##I; \
        touch ^= t4.x ^ t4.y ^ t4.z ^ t4.w ^ bds_##I.x ^ bds_##I.y; \
    }
#elif defined(DATA_A_Q5_1)
    const uint nround = (nblk + LPR - 1) / LPR;
    const uint arow   = e * p.expert_stride + rowc * nblk;

#define LOAD_A(I) \
    uint b##I; float kp##I; uvec2 w0_##I, w1_##I, w2_##I; \
    if (I < MAXR) { \
        const uint bi = (i0 + I) * LPR + l; \
        b##I  = min(bi, nblk - 1); \
        kp##I = bi < nblk ? 1.0 : 0.0; \
        const uint a = (arow + b##I) * 3; \
        w0_##I = data_a[a]; \
        w1_##I = data_a[a + 1]; \
        w2_##I = data_a[a + 2]; \
    }
#define LOAD_B(K, I) \
    uvec4 bq0_##I, bq1_##I; uint bds_##I; \
    if (I < MAXR) { \
        const uint bb = brow[K] * nblk + b##I; \
        const uint gi = (bb / 4) * 9; \
        bq0_##I = data_b[gi + 1 + (bb % 4) * 2]; \
        bq1_##I = data_b[gi + 2 + (bb % 4) * 2]; \
        bds_##I = data_b32[gi * 4 + bb % 4]; \
    }
#define DEC_A(I) \
    vec2 dm_##I; uvec4 lo_##I, hi_##I; \
    if (I < MAXR) { \
        dm_##I = unpackHalf2x16(w0_##I.x) * kp##I; \
        const uint  qh = w0_##I.y; \
        const uvec4 qs = uvec4(w1_##I, w2_##I); \
        /* the fifth bit of codes 4w..4w+3 (low nibbles) and 16+4w.. (high) to bit 4 of their bytes */ \
        const uvec4 h0 = ((uvec4(qh, qh >> 4, qh >> 8, qh >> 12) & 0xFu) * 0x02040810u) & 0x10101010u; \
        const uvec4 h1 = ((uvec4(qh >> 16, qh >> 20, qh >> 24, qh >> 28) & 0xFu) * 0x02040810u) & 0x10101010u; \
        lo_##I = (qs & 0x0F0F0F0Fu) | h0; \
        hi_##I = ((qs >> 4) & 0x0F0F0F0Fu) | h1; \
    }
#define COMP(K, I) \
    if (I < MAXR) { \
        const vec2 ds = unpackHalf2x16(bds_##I); \
        acc[K] += dm_##I.x * ds.x * float(dot16(lo_##I, bq0_##I) + dot16(hi_##I, bq1_##I)) + dm_##I.y * ds.y; \
    }
#define TOUCH(K, I) \
    if (I < MAXR) { \
        const uvec4 t4 = bq0_##I ^ bq1_##I; \
        const uvec2 t2 = w0_##I ^ w1_##I ^ w2_##I; \
        touch ^= t4.x ^ t4.y ^ t4.z ^ t4.w ^ t2.x ^ t2.y ^ bds_##I; \
    }
#endif

#define ROUNDS(M, K) M(K, 0) M(K, 1) M(K, 2) M(K, 3) M(K, 4) M(K, 5) M(K, 6) M(K, 7)
#define TOKEN(K) \
    if (K < cnt) { \
        ROUNDS(LOAD_B, K) \
        ROUNDS(COMP, K) \
    }

    for (uint i0 = 0; i0 < nround; i0 += MAXR) {
        LOAD_A(0) LOAD_A(1) LOAD_A(2) LOAD_A(3) LOAD_A(4) LOAD_A(5) LOAD_A(6) LOAD_A(7)
        // every workgroup has a first token: its activations go out with the weights
        ROUNDS(LOAD_B, 0)
        if (FENCE != 0 && p.fusion_flags == 0xFFFFFFFFu) {
            uint touch = 0;
            ROUNDS(TOUCH, 0)
            data_d[0] = uintBitsToFloat(touch);
        }
        DEC_A(0) DEC_A(1) DEC_A(2) DEC_A(3) DEC_A(4) DEC_A(5) DEC_A(6) DEC_A(7)
        ROUNDS(COMP, 0)
        TOKEN(1) TOKEN(2) TOKEN(3) TOKEN(4) TOKEN(5) TOKEN(6) TOKEN(7)
    }
#undef TOKEN
#undef TOUCH
#undef ROUNDS
#undef LOAD_A
#undef LOAD_B
#undef DEC_A
#undef COMP

    [[unroll]] for (uint k = 0; k < NT; ++k) {
        if (k < cnt) {
            const float v = subgroupClusteredAdd(acc[k], LPR);
            if (l == 0 && row < p.nrows) {
                float r = v;
                if ((p.fusion_flags & 4u) != 0) {
                    r *= data_fuse0[tok[k] * p.nei0 + slt[k]];
                }
                data_d[tok[k] * p.batch_stride_d + slt[k] * p.stride_d + row] = r;
            }
        }
    }
}
