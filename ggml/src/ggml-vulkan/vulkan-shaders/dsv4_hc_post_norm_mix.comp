#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "types.glsl"

// fork: dsv4_hc_post_norm.comp (N_F16) for the four streams of a token in one workgroup, and the injection of the hc
// mix that reads the normalized streams (qwen4exp: MUL_MAT(xn, w_inject) -> TRANSPOSE -> CONT) from them:
//
//   d[i0, s, it]  = x[i0, it]*post[s, it] + residual[i0, s, it]
//   n[i0, s, it]  = f16(d[i0, s, it]*inversesqrt(mean_i0(d[., s, it]^2) + eps)*w[i0, s, it])
//   inj[j, it]    = sum_{s, i0} n[i0, s, it]*wi[s*n_embd + i0, j]
//
// d and n take the operations of dsv4_hc_post_norm.comp in the same order (the same bits). q8 != 0: n also goes to
// Q as the q8_1 x4 blocks of the flattened [HC*n_embd, n_tokens] tensor, with the layout and the arithmetic of
// quantize_q8_1.comp (QBLOCK_X4, A_F16): the int8 matmul of the hc down reads them instead of quantizing n again
// (ggml_vk_dsv4_hc_post_norm).

layout(constant_id = 0) const uint BLOCK_SIZE = 512;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter
{
    uint n_embd;
    uint n_tokens;

    uint nbx1;                  // x
    uint nbr1; uint nbr2;       // residual
    uint nbp0; uint nbp1;       // post
    uint nbw1; uint nbw2;       // gamma, 0 for a broadcast dim
    uint nbd1; uint nbd2;       // d
    uint nbn1; uint nbn2;       // n

    uint x_offset;
    uint r_offset;
    uint p_offset;
    uint w_offset;
    uint d_offset;
    uint n_offset;

    uint gate;               // post = gate_scale_out*sigmoid(gate_scale_in*p)
    float gate_scale_in;
    float gate_scale_out;
    float eps;

    uint nbwi1;              // wi, the stride of its columns
    uint wi_offset;
    uint inj_offset;         // inj [HC, n_tokens], contiguous
    uint q8;
};

layout(binding = 0, std430) readonly buffer X { float data_x[]; };
layout(binding = 1, std430) readonly buffer R { float data_r[]; };
layout(binding = 2, std430) readonly buffer P { float data_p[]; };
layout(binding = 3, std430) readonly buffer W { float data_w[]; };
layout(binding = 4, std430) writeonly buffer D { float data_d[]; };
layout(binding = 5, std430) writeonly buffer N { float16_t data_n[]; };
layout(binding = 6, std430) readonly buffer WI { float data_wi[]; };
layout(binding = 7, std430) writeonly buffer INJ { float data_inj[]; };
layout(binding = 8, std430) writeonly buffer Q { block_q8_1_x4 data_q[]; };

const uint HC = 4;

// n_embd <= MAX_COLS*BLOCK_SIZE and n_embd % 128 == 0 when q8 != 0, the host checks it
const uint MAX_COLS = 8;

shared vec4 red[BLOCK_SIZE];
// the f16 values of one stream as floats (exact), for the q8_1 blocks
shared float sh_n[MAX_COLS * BLOCK_SIZE];

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint it  = gl_WorkGroupID.x;

    float post[HC];
    [[unroll]] for (uint s = 0; s < HC; ++s) {
        const float p = data_p[p_offset + s * nbp0 + it * nbp1];
        post[s] = gate != 0 ? (1.0f / (1.0f + exp(-(p * gate_scale_in)))) * gate_scale_out : p;
    }

    const uint xb = x_offset + it * nbx1;

    float v[HC][MAX_COLS];
    vec4 ss = vec4(0.0f);

    [[unroll]]
    for (uint k = 0; k < MAX_COLS; ++k) {
        const uint i0 = k * BLOCK_SIZE + tid;
        const float xv = i0 < n_embd ? data_x[xb + i0] : 0.0f;
        [[unroll]] for (uint s = 0; s < HC; ++s) {
            v[s][k] = 0.0f;
            if (i0 < n_embd) {
                v[s][k] = fma(xv, post[s], data_r[r_offset + s * nbr1 + it * nbr2 + i0]);
                ss[s] = fma(v[s][k], v[s][k], ss[s]);
            }
        }
    }

    red[tid] = ss;
    barrier();
    [[unroll]]
    for (uint h = BLOCK_SIZE / 2; h > 0; h >>= 1) {
        if (tid < h) {
            red[tid] += red[tid + h];
        }
        barrier();
    }
    const vec4 sums = red[0];
    barrier();

    vec4 inj = vec4(0.0f);

    [[unroll]]
    for (uint s = 0; s < HC; ++s) {
        const float scale = inversesqrt(sums[s] / float(n_embd) + eps);

        const uint db = d_offset + s * nbd1 + it * nbd2;
        const uint wb = w_offset + s * nbw1 + it * nbw2;
        const uint nb = n_offset + s * nbn1 + it * nbn2;
        const uint wib = wi_offset + s * n_embd;

        [[unroll]]
        for (uint k = 0; k < MAX_COLS; ++k) {
            const uint i0 = k * BLOCK_SIZE + tid;
            if (i0 < n_embd) {
                data_d[db + i0] = v[s][k];
                const float16_t n = float16_t(v[s][k] * scale * data_w[wb + i0]);
                data_n[nb + i0] = n;
                const float nf = float(n);
                const uint wi = wib + i0;
                inj = fma(vec4(nf), vec4(data_wi[wi], data_wi[wi + nbwi1], data_wi[wi + 2 * nbwi1], data_wi[wi + 3 * nbwi1]), inj);
                if (q8 != 0) {
                    sh_n[i0] = nf;
                }
            }
        }

        if (q8 != 0) {
            barrier();
            // one invocation per block of 32 values: amax, d = amax/127, q = round(n/d) and the sum of q, as
            // quantize_q8_1.comp computes them (max and the integer sums do not depend on the order)
            const uint n_blocks = n_embd / 32;
            for (uint b = tid; b < n_blocks; b += BLOCK_SIZE) {
                const uint base = b * 32;
                float amax = 0.0f;
                [[unroll]] for (uint e = 0; e < 32; ++e) {
                    amax = max(amax, abs(sh_n[base + e]));
                }
                const float d = amax / 127.0;
                const float d_inv = d != 0.0 ? 1.0 / d : 0.0;

                const uint ib    = (it * HC * n_embd + s * n_embd + base) / 32;
                const uint outer = ib / 4;
                const uint inner = ib % 4;

                float sum = 0.0f;
                [[unroll]] for (uint c = 0; c < 8; ++c) {
                    vec4 vals = vec4(sh_n[base + 4 * c], sh_n[base + 4 * c + 1], sh_n[base + 4 * c + 2], sh_n[base + 4 * c + 3]);
                    vals = round(vals * d_inv);
                    data_q[outer].qs[inner * 8 + c] = pack32(i8vec4(round(vals)));
                    sum += vals.x + vals.y + vals.z + vals.w;
                }
                data_q[outer].ds[inner] = f16vec2(vec2(d, sum * d));
            }
            barrier();
        }
    }

    red[tid] = inj;
    barrier();
    [[unroll]]
    for (uint h = BLOCK_SIZE / 2; h > 0; h >>= 1) {
        if (tid < h) {
            red[tid] += red[tid + h];
        }
        barrier();
    }
    if (tid == 0) {
        const vec4 r = red[0];
        const uint ob = inj_offset + it * HC;
        data_inj[ob + 0] = r.x;
        data_inj[ob + 1] = r.y;
        data_inj[ob + 2] = r.z;
        data_inj[ob + 3] = r.w;
    }
}
