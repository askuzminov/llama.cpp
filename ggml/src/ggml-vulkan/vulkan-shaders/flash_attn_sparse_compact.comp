#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#ifdef USE_SUBGROUPS
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const uint BLOCK_SIZE = 128;
layout(constant_id = 1) const uint NUM_SUBGROUPS = 1;

layout (binding = 0) readonly buffer M {float16_t data_m[];};
layout (binding = 1) writeonly buffer I {int32_t data_i[];};

layout (push_constant) uniform parameter {
    uint KV;
    uint nem1;
    uint nem2;
    uint nbm1;
    uint nbm2;
    uint nbm3;
    uint n_kv_max;
    uint rows_per_group;
    uint capacity;
} p;

#ifdef USE_SUBGROUPS
shared uint counts_sh[NUM_SUBGROUPS];
#else
shared uint scan[BLOCK_SIZE];
#endif

// a position is kept when any row of the group keeps it
bool is_selected(const uint m_idx, const uint n_rows) {
    for (uint r = 0; r < n_rows; ++r) {
        const float v = float(data_m[m_idx + r * p.nbm1]);
        if (!isinf(v) && !isnan(v)) {
            return true;
        }
    }
    return false;
}

// One workgroup per group of rows_per_group mask rows: compact the KV positions that any row
// of the group keeps into one index list of capacity slots, -1 padded, in ascending KV order so
// the downstream attention accumulation is deterministic. With rows_per_group == 1 the list is
// exact; a wider group holds the union, which the attention shader then masks per row.
// The row is split into contiguous segments, one per subgroup (or per thread
// without subgroups), so it needs a single workgroup scan instead of one per
// BLOCK_SIZE chunk.
void main() {
    const uint i1 = gl_WorkGroupID.x;
    const uint i2 = gl_WorkGroupID.y;
    const uint i3 = gl_WorkGroupID.z;
    const uint tid = gl_LocalInvocationIndex;

    const uint m_base   = i3 * p.nbm3 + i2 * p.nbm2 + i1 * p.rows_per_group * p.nbm1;
    const uint out_base = ((i3 * p.nem2 + i2) * gl_NumWorkGroups.x + i1) * p.capacity;
    const uint n_rows   = min(p.rows_per_group, p.nem1 - i1 * p.rows_per_group);

#ifdef USE_SUBGROUPS
    const uint sg   = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint seg  = (p.KV + gl_NumSubgroups - 1) / gl_NumSubgroups;
    const uint seg_begin = min(sg * seg, p.KV);
    const uint seg_end   = min(seg_begin + seg, p.KV);

    // Lanes read consecutive positions, so each step is one coalesced load.
    uint count = 0;
    for (uint k0 = seg_begin; k0 < seg_end; k0 += gl_SubgroupSize) {
        const uint k = k0 + lane;
        count += subgroupBallotBitCount(subgroupBallot(k < seg_end && is_selected(m_base + k, n_rows)));
    }
    if (subgroupElect()) {
        counts_sh[sg] = count;
    }
    barrier();

    uint slot = 0;
    uint total = 0;
    for (uint s = 0; s < gl_NumSubgroups; ++s) {
        slot  += s < sg ? counts_sh[s] : 0u;
        total += counts_sh[s];
    }

    for (uint k0 = seg_begin; k0 < seg_end && slot < p.capacity; k0 += gl_SubgroupSize) {
        const uint k = k0 + lane;
        const bool selected = k < seg_end && is_selected(m_base + k, n_rows);
        const uvec4 ballot = subgroupBallot(selected);
        const uint pos = slot + subgroupBallotExclusiveBitCount(ballot);
        if (selected && pos < p.capacity) {
            data_i[out_base + pos] = int32_t(k);
        }
        slot += subgroupBallotBitCount(ballot);
    }
#else
    const uint run   = (p.KV + BLOCK_SIZE - 1) / BLOCK_SIZE;
    const uint begin = min(tid * run, p.KV);
    const uint end   = min(begin + run, p.KV);

    uint count = 0;
    for (uint k = begin; k < end; ++k) {
        count += is_selected(m_base + k, n_rows) ? 1u : 0u;
    }

    // Hillis-Steele inclusive prefix sum of the per-thread counts.
    scan[tid] = count;
    barrier();
    for (uint off = 1; off < BLOCK_SIZE; off <<= 1) {
        uint add = 0;
        if (tid >= off) {
            add = scan[tid - off];
        }
        barrier();
        scan[tid] += add;
        barrier();
    }

    const uint total = scan[BLOCK_SIZE - 1];
    uint slot = scan[tid] - count;
    for (uint k = begin; k < end && slot < p.capacity; ++k) {
        if (is_selected(m_base + k, n_rows)) {
            data_i[out_base + slot] = int32_t(k);
            ++slot;
        }
    }
#endif

    for (uint s = min(total, p.capacity) + tid; s < p.capacity; s += BLOCK_SIZE) {
        data_i[out_base + s] = int32_t(-1);
    }
}
