#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#if defined(STABLE) && defined(USE_SUBGROUPS)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif

#include "types.glsl"

layout(constant_id = 0) const int BLOCK_SIZE = 1024;
layout(constant_id = 1) const int QSA = 0; // 1: fuse the qwen4 QSA indexer gather + f16 mask
#ifdef STABLE
layout(constant_id = 2) const uint NUM_SUBGROUPS = 1; // fork: the subgroups of the workgroup (USE_SUBGROUPS)
#endif

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A  {float     data_a[];};   // input values, or QSA block scores [n_tps, n_blocks, n_stream]
layout (binding = 1) writeonly buffer D {int       data_d[];};   // [k, ...]
layout (binding = 2) readonly buffer CB {int       cell_blk[];}; // QSA: cell->block map [n_kv, n_stream]
layout (binding = 3) readonly buffer M  {float16_t mask[];};     // QSA: raw f16 kq_mask [n_kv, n_tps, n_stream]
layout (binding = 4) buffer S           {float     scratch[];};  // QSA: [nrows, n_kv] gathered inputs

layout (push_constant) uniform parameter {
    uint ncols;
    uint k;
    uint nrows;
    uint n_tps;    // QSA only
    uint n_blocks; // QSA only
    uint n_stream; // QSA only
} p;

#define RADIX_BITS 8
#define RADIX_SIZE (1 << RADIX_BITS)

shared uint histo[RADIX_SIZE];
shared uint sh_bucket;
shared uint sh_above;
shared uint out_count;
#ifdef STABLE
#ifdef USE_SUBGROUPS
shared uint sg_above[NUM_SUBGROUPS];
shared uint sg_tie[NUM_SUBGROUPS];
#else
shared uint scan_above[BLOCK_SIZE];
shared uint scan_tie[BLOCK_SIZE];
#endif
#endif

// order-preserving float -> uint mapping
uint f2ui(float x) {
    uint y = floatBitsToUint(x);
    if ((y & 0x80000000u) != 0u) {
        y ^= 0xFFFFFFFFu;
    } else {
        y |= 0x80000000u;
    }
    return y;
}

// QSA element i of row (t,s): score[cell_blk[i,s], t, s] + mask[i,t,s]
float gather(uint row, uint i) {
    const uint t = row % p.n_tps;
    const uint s = row / p.n_tps;
    const uint block = uint(cell_blk[s * p.ncols + i]);
    const float a = data_a[(s * p.n_blocks + block) * p.n_tps + t];
    const float m = float(mask[(s * p.n_tps + t) * p.ncols + i]);
    return a + m;
}

float load(uint row, uint i, bool first) {
    if (QSA == 0) {
        return data_a[row * p.ncols + i];
    }
    // materialize the scattered gather on the first pass and reuse it after; each
    // invocation only touches its own scratch entries, so no barrier is needed
    const uint off = row * p.ncols + i;
    if (first) {
        const float v = gather(row, i);
        scratch[off] = v;
        return v;
    }
    return scratch[off];
}

#ifdef STABLE
// fork: the input of element i. the stable select reads elements that other invocations loaded in the passes, so the QSA
// variant gathers them again instead of reading the scratch of another invocation
float value(const uint row, const uint i) {
    return QSA == 0 ? data_a[row * p.ncols + i] : gather(row, i);
}

// fork: the elements above the threshold in ascending index order, then the ties from the lowest index, so that the output
// does not depend on the order the invocations run in. the atomic compaction below gave another order and, at ties, other
// elements from run to run, and with them the order the attention adds the chosen blocks in (the qwen4exp block top-k of a
// prompt past 4096 cells, 01.11). as flash_attn_sparse_compact.comp: a contiguous segment per subgroup (per invocation
// without subgroups) and one scan over the segments
void emit_stable(const uint row, const uint row_out, const uint threshold, const uint n_above) {
    const uint ncols = p.ncols;
#ifdef USE_SUBGROUPS
    const uint sg        = gl_SubgroupID;
    const uint lane      = gl_SubgroupInvocationID;
    const uint seg       = (ncols + gl_NumSubgroups - 1) / gl_NumSubgroups;
    const uint seg_begin = min(sg * seg, ncols);
    const uint seg_end   = min(seg_begin + seg, ncols);

    uint n_a = 0;
    uint n_t = 0;
    for (uint i0 = seg_begin; i0 < seg_end; i0 += gl_SubgroupSize) {
        const uint i   = i0 + lane;
        const uint key = i < seg_end ? f2ui(value(row, i)) : 0u;
        n_a += subgroupBallotBitCount(subgroupBallot(i < seg_end && key >  threshold));
        n_t += subgroupBallotBitCount(subgroupBallot(i < seg_end && key == threshold));
    }
    if (subgroupElect()) {
        sg_above[sg] = n_a;
        sg_tie[sg]   = n_t;
    }
    barrier();

    uint at = 0;
    uint tt = 0;
    for (uint s = 0; s < sg; ++s) {
        at += sg_above[s];
        tt += sg_tie[s];
    }
    for (uint i0 = seg_begin; i0 < seg_end; i0 += gl_SubgroupSize) {
        const uint  i     = i0 + lane;
        const uint  key   = i < seg_end ? f2ui(value(row, i)) : 0u;
        const bool  above = i < seg_end && key >  threshold;
        const bool  tie   = i < seg_end && key == threshold;
        const uvec4 ba    = subgroupBallot(above);
        const uvec4 bt    = subgroupBallot(tie);
        if (above) {
            data_d[row_out + at + subgroupBallotExclusiveBitCount(ba)] = int(i);
        }
        const uint pos = n_above + tt + subgroupBallotExclusiveBitCount(bt);
        if (tie && pos < p.k) {
            data_d[row_out + pos] = int(i);
        }
        at += subgroupBallotBitCount(ba);
        tt += subgroupBallotBitCount(bt);
    }
    // sg_above and sg_tie are written again by the next row
    barrier();
#else
    const uint tid   = gl_LocalInvocationID.x;
    const uint run   = (ncols + BLOCK_SIZE - 1) / BLOCK_SIZE;
    const uint begin = min(tid * run, ncols);
    const uint end   = min(begin + run, ncols);

    uint n_a = 0;
    uint n_t = 0;
    for (uint i = begin; i < end; ++i) {
        const uint key = f2ui(value(row, i));
        n_a += key >  threshold ? 1u : 0u;
        n_t += key == threshold ? 1u : 0u;
    }
    // Hillis-Steele inclusive prefix sums of the counts of the invocations
    scan_above[tid] = n_a;
    scan_tie[tid]   = n_t;
    barrier();
    for (uint off = 1; off < BLOCK_SIZE; off <<= 1) {
        uint a = 0;
        uint t = 0;
        if (tid >= off) {
            a = scan_above[tid - off];
            t = scan_tie[tid - off];
        }
        barrier();
        scan_above[tid] += a;
        scan_tie[tid]   += t;
        barrier();
    }
    uint at = scan_above[tid] - n_a;
    uint tt = scan_tie[tid] - n_t;
    for (uint i = begin; i < end; ++i) {
        const uint key = f2ui(value(row, i));
        if (key > threshold) {
            data_d[row_out + at] = int(i);
            at++;
        } else if (key == threshold) {
            const uint pos = n_above + tt;
            tt++;
            if (pos < p.k) {
                data_d[row_out + pos] = int(i);
            }
        }
    }
    // scan_above and scan_tie are written again by the next row
    barrier();
#endif
}
#endif

// one workgroup per row: radix-select the K-th largest, then compact it plus enough ties
void topk(const uint row) {
    const uint tid = gl_LocalInvocationID.x;
    const uint ncols = p.ncols;
    const uint row_out = row * p.k;

    uint prefix  = 0;     // fixed high bits of the threshold key
    uint desired = p.k;   // count still needed from the candidate range

    [[unroll]] for (int shift = 32 - RADIX_BITS; shift >= 0; shift -= RADIX_BITS) {
        for (uint i = tid; i < RADIX_SIZE; i += BLOCK_SIZE) {
            histo[i] = 0;
        }
        barrier();

        const bool first     = (shift == 32 - RADIX_BITS);
        const uint hi_mask   = (shift + RADIX_BITS >= 32) ? 0u : (0xFFFFFFFFu << uint(shift + RADIX_BITS));
        const uint prefix_hi = prefix & hi_mask;
        for (uint i = tid; i < ncols; i += BLOCK_SIZE) {
            const uint key = f2ui(load(row, i, first));
            if ((key & hi_mask) == prefix_hi) {
                atomicAdd(histo[(key >> uint(shift)) & (RADIX_SIZE - 1)], 1u);
            }
        }
        barrier();

        // top-down scan for the bucket holding the K-th value
        if (tid == 0) {
            uint acc = 0;
            uint b   = 0;
            for (int bb = RADIX_SIZE - 1; bb >= 0; --bb) {
                const uint c = histo[bb];
                if (acc + c >= desired) { b = uint(bb); break; }
                acc += c;
            }
            sh_bucket = b;
            sh_above  = acc;
        }
        barrier();

        prefix  |= sh_bucket << uint(shift);
        desired -= sh_above;
        barrier();
    }

#ifdef STABLE
    // desired is what the ties still give, so the elements above the threshold are the rest of k
    emit_stable(row, row_out, prefix, p.k - desired);
#else
    if (tid == 0) {
        out_count = 0;
    }
    barrier();

    // emit everything above the threshold, then fill the rest from ties
    const uint threshold = prefix;
    for (uint i = tid; i < ncols; i += BLOCK_SIZE) {
        if (f2ui(load(row, i, false)) > threshold) {
            data_d[row_out + atomicAdd(out_count, 1u)] = int(i);
        }
    }
    barrier();
    for (uint i = tid; i < ncols; i += BLOCK_SIZE) {
        if (f2ui(load(row, i, false)) == threshold) {
            const uint pos = atomicAdd(out_count, 1u);
            if (pos < p.k) {
                data_d[row_out + pos] = int(i);
            }
        }
    }
#endif
}

void main() {
    for (uint row = gl_WorkGroupID.y; row < p.nrows; row += gl_NumWorkGroups.y) {
        topk(row);
    }
}
