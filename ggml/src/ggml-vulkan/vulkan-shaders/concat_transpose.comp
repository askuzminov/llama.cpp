#version 450

#include "types.glsl"
#include "generic_binary_head.glsl"

// workgroup does a 32x32 tile of dst dims 0 and 1, but uses 32x8 threads
#define TILE_DIM 32
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

// +1 padding avoids shared-memory bank conflicts on both access orders
shared uint sh[TILE_DIM][TILE_DIM + 1];

void iter(uvec3 wg_id) {
    const uint tid_col = gl_LocalInvocationID.x;
    const uint tid_row = gl_LocalInvocationID.y;

    const uint i2 = wg_id.z % p.ne22;
    const uint i3 = wg_id.z / p.ne22;

    const int dim = p.param3;
    uint o[4] = {0, 0, 0, 0};
    o[dim] = dim == 0 ? p.ne00 : (dim == 1 ? p.ne01 : (dim == 2 ? p.ne02 : p.ne03));

    // a source with the smaller stride in dim 1 is read with tid_col in dim 1, so both reads are contiguous
    const bool a_t = p.nb01 < p.nb00;
    const bool b_t = p.nb11 < p.nb10;

    [[unroll]] for (uint t = 0; t < 2; ++t) {
        [[unroll]] for (uint y = 0; y < 4; ++y) {
            const uint l0 = t == 0 ? tid_col : tid_row + 8 * y;
            const uint l1 = t == 0 ? tid_row + 8 * y : tid_col;
            const uint i0 = wg_id.x * TILE_DIM + l0;
            const uint i1 = wg_id.y * TILE_DIM + l1;
            if (i0 >= p.ne20 || i1 >= p.ne21) {
                continue;
            }
            const bool is_src0 = i0 < p.ne00 && i1 < p.ne01 && i2 < p.ne02 && i3 < p.ne03;
            if ((is_src0 ? a_t : b_t) != (t == 1)) {
                continue;
            }
            if (is_src0) {
                sh[l0][l1] = uint(data_a[get_aoffset() + i3*p.nb03 + i2*p.nb02 + i1*p.nb01 + i0*p.nb00]);
            } else {
                sh[l0][l1] = uint(data_b[get_boffset() + (i3 - o[3])*p.nb13 + (i2 - o[2])*p.nb12 + (i1 - o[1])*p.nb11 + (i0 - o[0])*p.nb10]);
            }
        }
    }

    barrier();

    [[unroll]] for (uint y = 0; y < 4; ++y) {
        const uint i0 = wg_id.x * TILE_DIM + tid_col;
        const uint i1 = wg_id.y * TILE_DIM + tid_row + 8 * y;
        if (i0 < p.ne20 && i1 < p.ne21) {
            data_d[get_doffset() + i3*p.nb23 + i2*p.nb22 + i1*p.nb21 + i0*p.nb20] = D_TYPE(sh[tid_col][tid_row + 8 * y]);
        }
    }
}

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))

// Consecutive workgroups go down GROUP_ROWS tile rows before the next tile column.
// So the running tiles form a compact block, and the reads and writes use longer runs of each memory row.
#define GROUP_ROWS 16u

void main() {
    const uint nx = CEIL_DIV(p.ne20, TILE_DIM);
    const uint ny = CEIL_DIV(p.ne21, TILE_DIM);
    bool need_barrier = false;
    for (uint z = gl_WorkGroupID.z; z < p.ne22 * p.ne23; z += gl_NumWorkGroups.z) {
        for (uint y = gl_WorkGroupID.y; y < ny; y += gl_NumWorkGroups.y) {
            for (uint x = gl_WorkGroupID.x; x < nx; x += gl_NumWorkGroups.x) {
                if (need_barrier) {
                    barrier();
                }
                need_barrier = true;
                const uint l = y * nx + x;
                const uint row0 = l / (GROUP_ROWS * nx) * GROUP_ROWS;
                const uint rows = min(GROUP_ROWS, ny - row0);
                const uint r = l - row0 * nx;
                iter(uvec3(r / rows, row0 + r % rows, z));
            }
        }
    }
}
