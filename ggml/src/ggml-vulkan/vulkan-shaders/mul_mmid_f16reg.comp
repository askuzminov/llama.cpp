#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#ifdef EMULATE
#extension GL_KHR_shader_subgroup_shuffle : require
#else
#extension GL_KHR_cooperative_matrix : require
#endif

// fork: MUL_MAT_ID of the MoE experts on f16 WMMA with the quantized A decoded in registers (as gufo's routed expert
// GEMM): the 4/5/8-bit codes of a 128-row by 64-column A tile go to shared memory as they are, each subgroup decodes the
// 16 values of its A fragment straight into the fragment, with the block scale and offset folded in, and accumulates in
// f32 over the whole K. the int8 path pays a float epilogue and a min correction per 32-column block of every output
// fragment, and quantizes the activations to 8 bits; here B is the f16 activations.
//
// A fragment layout taken (RDNA3, subgroup 32): element e of invocation l is row l % 16, column e, the two halves of
// the subgroup holding the same rows; coopmat_a_probe.comp checks it at device init. EMULATE runs the same algorithm with
// subgroup shuffles instead of coopmat (no matrix cores needed), for the tests of devices without them.
//
// q4_K, q5_K: a 64-column stage is the 32-byte qs chunk of two sub-blocks (low and high nibbles), q5_1: two blocks
// repacked to that layout, q8_0: two blocks of bytes. FUSED_GLU: binding 6 is the up projection, the result silu(A x) *
// (A2 x). ROWS2: the workgroup takes 256 rows, the second 128 as the second A of FUSED_GLU (same binding, rows + 128),
// so that each B fragment serves two A fragments as in the fused gate/up (07.11: the down projection, K 640, ran at
// 12.7 TFLOP/s on the 395 against 18.6 of the fused gate/up). fusion_flags bit 0: the router weight of each (slot,
// token) scales the result (MUL_MAT_ID + MUL).
// GLU_SPLIT: the fused gate/up with the gate in subgroups 0-3 and the up projection in 4-7 over the same 64 rows (as
// gufo's kPair), each subgroup one A tile as a single matmul, the two met through shared memory at the end: the
// registers of a single matmul instead of two sets of sums.
// BN (16..128 tokens a tile, a multiple of 16): count_experts.comp lays the rows of each expert out in tiles of BN, the
// fragments past the rows of a tile are skipped. with coopmat the sums are named by constant indices (an array indexed
// at run time goes to scratch memory on the AMD driver, see mul_mm_f16reg.comp); the emulation keeps loops.
// BPF 0: each stage reads its own B tile (no next-stage B in registers). EPI 1: the sums go to memory straight from
// the accumulator elements, in the RDNA3 layout that coopmat_c_probe.comp checks (element e of invocation l: row
// (l / 16) + 2 e, column l % 16), without the 8 KB of shared memory of the output fragments. B_F16 1: B is f16 (the
// host converts the activations once), 8 per uvec4

#if defined(DATA_A_Q4_K)
#define A_BLOCK_WORDS 36   // 144 bytes
#define A_QK 256
#elif defined(DATA_A_Q5_K)
#define A_BLOCK_WORDS 44   // 176 bytes
#define A_QK 256
#define A_HIGH_BIT 1
#elif defined(DATA_A_Q5_1)
#define A_BLOCK_WORDS 6    // 24 bytes
#define A_QK 32
#define A_HIGH_BIT 1
#elif defined(DATA_A_Q8_0)
#define A_BLOCK_HALFS 17   // 34 bytes
#define A_QK 32
#define A_BYTES 1
#else
#error mul_mmid_f16reg.comp: no A type
#endif

#if defined(FUSED_GLU) || defined(ROWS2)
#define TWO_A
#endif
#if defined(FUSED_GLU) && defined(ROWS2) || defined(GLU_SPLIT) && (defined(FUSED_GLU) || defined(ROWS2))
#error mul_mmid_f16reg.comp: FUSED_GLU, ROWS2 and GLU_SPLIT exclude each other
#endif
#if defined(FUSED_GLU) || defined(GLU_SPLIT)
#define HAS_A2
#endif

layout(constant_id = 0) const uint BLOCK_SIZE = 256;
layout(constant_id = 1) const uint BN = 64;
layout(constant_id = 2) const uint BPF = 1;
layout(constant_id = 3) const uint EPI = 0;
layout(constant_id = 4) const uint B_F16 = 0;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#ifdef A_BYTES
layout(binding = 0) readonly buffer A { uint16_t data_a[]; };
#ifdef HAS_A2
layout(binding = 6) readonly buffer A2 { uint16_t data_a2[]; };
#endif
#else
layout(binding = 0) readonly buffer A { uint data_a[]; };
#ifdef HAS_A2
layout(binding = 6) readonly buffer A2 { uint data_a2[]; };
#endif
#endif
layout(binding = 1) readonly buffer B { uvec4 data_b[]; };   // 4 f32 or 8 f16
layout(binding = 2) writeonly buffer D { float data_d[]; };
layout(binding = 3) readonly buffer IDS { int data_ids[]; };
layout(binding = 4) readonly buffer RowMap { uint data_row_map[]; };
layout(binding = 5) readonly buffer FusedScale { float data_fscale[]; };

layout(push_constant) uniform parameter {
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;
    uint nei0;
    uint nei1;
    uint nbi1;
    uint ne11;
    uint n_experts;
    uint row_ids_offset;
    uint fusion_flags;
} p;

const uint BM   = 128;          // rows of an A tile: 8 subgroups of 16 rows
#if defined(ROWS2)
const uint BMW  = 2 * BM;       // rows of the workgroup
#elif defined(GLU_SPLIT)
const uint BMW  = BM / 2;       // 64 rows of the gate in subgroups 0-3 and of the up projection in 4-7
#else
const uint BMW  = BM;
#endif
const uint BK   = 64;           // columns per stage
const uint BKP  = BK + 8;       // B column pitch in halves
const uint NC   = BN / 16;      // B fragments per subgroup, <= 8
const uint WARP = 32;

#ifdef A_BYTES
const uint QSW = 17;            // words of codes per row (16) + 1 against bank conflicts
#else
const uint QSW = 9;             // words of nibbles per row (8) + 1
#endif

shared uint      sh_qs[BM * QSW];
shared f16vec2   sh_so[BM * 2];             // (scale, offset) of the two 32-column sub-blocks: x = q * scale - offset
#ifdef A_HIGH_BIT
shared uint      sh_qh[BM * 2];             // bit e: the fifth bit of column e of a sub-block
#endif
#ifdef TWO_A
shared uint      sh_qs2[BM * QSW];
shared f16vec2   sh_so2[BM * 2];
#ifdef A_HIGH_BIT
shared uint      sh_qh2[BM * 2];
#endif
#endif
shared float16_t sh_b[BN * BKP];            // B tile, column n at n * BKP
// a 16x16 output fragment per subgroup; with EPI 1 none, but the up projection of GLU_SPLIT on its way to the gate
#ifdef GLU_SPLIT
const uint SH_C = EPI == 0 ? (BLOCK_SIZE / WARP) * 256 : (BLOCK_SIZE / WARP / 2) * 256;
#else
const uint SH_C = EPI == 0 ? (BLOCK_SIZE / WARP) * 256 : 1;
#endif
shared float     sh_c[SH_C];
shared u16vec2   row_ids[BN];

// ---- A tile: the codes of 128 rows x 64 columns, two invocations per row. the second A: the up projection (FUSED_GLU,
// binding 6) or the next 128 rows of the same experts (ROWS2)

#ifndef A_BYTES
uint a_word(const bool second, uint i) {
#ifdef HAS_A2
    return second ? data_a2[i] : data_a[i];
#else
    return data_a[i];
#endif
}
#else
uint a_half(const bool second, uint i) {
#ifdef HAS_A2
    return uint(second ? data_a2[i] : data_a[i]);
#else
    return uint(data_a[i]);
#endif
}
#endif

#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
// 6-bit scale and min of sub-block j from the 12 scale bytes (get_scale_min_k4). the words of each branch are fixed
// (j < 4: bytes j of words 0 and 1; else bytes j - 4 of words 2, 0, 1), so no array indexed at run time
uvec2 scale_min_k4(uint j, uint sw0, uint sw1, uint sw2) {
    uint d, m;
    if (j < 4) {
        d = (sw0 >> (8 * j)) & 63u;
        m = (sw1 >> (8 * j)) & 63u;
    } else {
        const uint q  = (sw2 >> (8 * (j - 4))) & 0xFFu;
        const uint lo = (sw0 >> (8 * (j - 4))) & 0xFFu;
        const uint hi = (sw1 >> (8 * (j - 4))) & 0xFFu;
        d = (q & 0xFu) | ((lo >> 6) << 4);
        m = (q >> 4)   | ((hi >> 6) << 4);
    }
    return uvec2(d, m);
}
#endif

// the next stage of this invocation in registers: its loads are in flight while the current stage computes
#ifdef A_BYTES
#define QREG 8
#else
#define QREG 4
#endif
uint    ra_qs[2][QREG];     // [binding 0, binding 6]
f16vec2 ra_so[2];
#ifdef A_HIGH_BIT
uint    ra_qh[2];
#endif

void load_a_tile(const uint m, const uint expert, const uint ir, const uint k0) {
    const uint tid  = gl_LocalInvocationID.x;
    const uint row  = tid >> 1;
    const uint h    = tid & 1;
#if defined(GLU_SPLIT)
    // rows 0-63 of the tile: the gate, 64-127: the up projection of the same rows
    const bool second = row >= BMW;
    const uint grow = ir * BMW + (row % BMW);
#elif defined(ROWS2)
    const bool second = m != 0;
    const uint grow = ir * BMW + (second ? BM : 0) + row;
#else
    const bool second = m != 0;
    const uint grow = ir * BMW + row;
#endif

    // first element of the row in blocks
    const uint row_blk = (expert * p.batch_stride_a + grow * p.stride_a) / A_QK;

#if defined(DATA_A_Q4_K) || defined(DATA_A_Q5_K)
    const uint j  = (k0 % 256) / 64;       // the 64-column chunk of the super-block
    const uint bw = (row_blk + k0 / 256) * A_BLOCK_WORDS;
    const vec2 dm = vec2(unpackHalf2x16(a_word(second, bw)));
    const uvec2 sm = scale_min_k4(2 * j + h, a_word(second, bw + 1), a_word(second, bw + 2), a_word(second, bw + 3));
    ra_so[m] = f16vec2(dm.x * float(sm.x), dm.y * float(sm.y));
#if defined(DATA_A_Q4_K)
    const uint qsw = bw + 4 + j * 8 + h * 4;
#else
    const uint qsw = bw + 12 + j * 8 + h * 4;
    // bit 2j + h of qh[l], l = 0..31, as bit l
    const uint sbit = 2 * j + h;
    uint qh = 0;
    [[unroll]] for (uint w = 0; w < 8; ++w) {
        const uint x = a_word(second, bw + 4 + w) >> sbit;
        qh |= ((x & 1u) | ((x >> 7) & 2u) | ((x >> 14) & 4u) | ((x >> 21) & 8u)) << (4 * w);
    }
    ra_qh[m] = qh;
#endif
    [[unroll]] for (uint i = 0; i < 4; ++i) {
        ra_qs[m][i] = a_word(second, qsw + i);
    }
#elif defined(DATA_A_Q5_1)
    // blocks k0 / 32 and k0 / 32 + 1: byte e of the chunk holds column e of the first block in its low nibble and of the
    // second in its high nibble, as a K-quant chunk; invocation h makes bytes 16h .. 16h + 15
    const uint bw0 = (row_blk + k0 / 32) * A_BLOCK_WORDS;
    const uint bw1 = bw0 + A_BLOCK_WORDS;
    const uint bwh = h == 0 ? bw0 : bw1;
    const vec2 dm = vec2(unpackHalf2x16(a_word(second, bwh)));
    ra_so[m] = f16vec2(dm.x, -dm.y);
    ra_qh[m] = a_word(second, bwh + 1);
    [[unroll]] for (uint i = 0; i < 4; ++i) {
        const uint q0 = a_word(second, bw0 + 2 + i);
        const uint q1 = a_word(second, bw1 + 2 + i);
        ra_qs[m][i] = h == 0 ? ((q0 & 0x0F0F0F0Fu) | ((q1 & 0x0F0F0F0Fu) << 4)) : (((q0 >> 4) & 0x0F0F0F0Fu) | (q1 & 0xF0F0F0F0u));
    }
#elif defined(DATA_A_Q8_0)
    // block k0 / 32 + h: its 32 bytes
    const uint bh = (row_blk + k0 / 32 + h) * A_BLOCK_HALFS;
    ra_so[m] = f16vec2(unpackHalf2x16(a_half(second, bh)).x, 0.0);
    [[unroll]] for (uint i = 0; i < 8; ++i) {
        ra_qs[m][i] = a_half(second, bh + 1 + 2 * i) | (a_half(second, bh + 2 + 2 * i) << 16);
    }
#endif
}

void write_a_tile(const uint m) {
    const uint tid = gl_LocalInvocationID.x;
    const uint row = tid >> 1;
    const uint h   = tid & 1;
#ifdef TWO_A
    if (m != 0) {
        [[unroll]] for (uint i = 0; i < QREG; ++i) { sh_qs2[row * QSW + h * QREG + i] = ra_qs[1][i]; }
        sh_so2[row * 2 + h] = ra_so[1];
#ifdef A_HIGH_BIT
        sh_qh2[row * 2 + h] = ra_qh[1];
#endif
        return;
    }
#endif
    [[unroll]] for (uint i = 0; i < QREG; ++i) { sh_qs[row * QSW + h * QREG + i] = ra_qs[0][i]; }
    sh_so[row * 2 + h] = ra_so[0];
#ifdef A_HIGH_BIT
    sh_qh[row * 2 + h] = ra_qh[0];
#endif
}

// ---- B tile: BN tokens x 64 columns of f32 activations as f16, four invocations per token, 16 columns each

const uint B_ITERS = (BN * 4 + BLOCK_SIZE - 1) / BLOCK_SIZE;
vec4  rb[2][4];  // B_ITERS <= 2 (BN <= 128): f32 B
uvec4 rbh[2][2]; // f16 B, 8 halves each

// the loops over it guard their body instead of a continue, so that they unroll and rb stays in registers (see
// mul_mm_f16reg.comp)
void load_b_tile(const uint k0, const uint tile_count) {
    const uint tid = gl_LocalInvocationID.x;
    [[unroll]] for (uint it = 0; it < 2; ++it) {
        const uint t = tid + it * BLOCK_SIZE;
        if (it < B_ITERS && t < BN * 4) {
            const uint n = t >> 2;
            const uint q = t & 3;
            if (n < tile_count) {
                const u16vec2 ri = row_ids[n];
                // a multiple of 8: K, the strides (of the f16 copy, or f32 with 16-byte steps) and k0 are
                const uint e0 = uint(ri.y) * p.batch_stride_b + (uint(ri.x) % p.ne11) * p.stride_b + k0 + q * 16;
                if (B_F16 != 0) {
                    rbh[it][0] = data_b[e0 / 8];
                    rbh[it][1] = data_b[e0 / 8 + 1];
                } else {
                    [[unroll]] for (uint i = 0; i < 4; ++i) {
                        rb[it][i] = uintBitsToFloat(data_b[e0 / 4 + i]);
                    }
                }
            } else {
                if (B_F16 != 0) {
                    rbh[it][0] = uvec4(0);
                    rbh[it][1] = uvec4(0);
                } else {
                    [[unroll]] for (uint i = 0; i < 4; ++i) {
                        rb[it][i] = vec4(0.0);
                    }
                }
            }
        }
    }
}

void write_b_tile() {
    const uint tid = gl_LocalInvocationID.x;
    [[unroll]] for (uint it = 0; it < 2; ++it) {
        const uint t = tid + it * BLOCK_SIZE;
        if (it < B_ITERS && t < BN * 4) {
            const uint n = t >> 2;
            const uint q = t & 3;
            [[unroll]] for (uint i = 0; i < 4; ++i) {
                f16vec4 v;
                if (B_F16 != 0) {
                    v = f16vec4(unpackFloat2x16(rbh[it][i >> 1][2 * (i & 1)]), unpackFloat2x16(rbh[it][i >> 1][2 * (i & 1) + 1]));
                } else {
                    v = f16vec4(rb[it][i]);
                }
                const uint o = n * BKP + q * 16 + i * 4;
                sh_b[o + 0] = v.x; sh_b[o + 1] = v.y; sh_b[o + 2] = v.z; sh_b[o + 3] = v.w;
            }
        }
    }
}

// ---- A fragment: 16 columns of the row of this invocation, fragment f (0..3) of the stage

// the f16 values of the four bytes of x (each below 256 and above -1024 after the bias): bytes 0, 2 and 1, 3
f16vec2 bytes02(uint x) { return unpackFloat2x16((x & 0x00FF00FFu) | 0x64006400u) - f16vec2(1024.0); }
f16vec2 bytes13(uint x) { return unpackFloat2x16(((x >> 8) & 0x00FF00FFu) | 0x64006400u) - f16vec2(1024.0); }

void decode_a(const bool second, const uint lrow, const uint f, out float16_t v[16]) {
#ifdef TWO_A
    const f16vec2 so = second ? sh_so2[lrow * 2 + (f >> 1)] : sh_so[lrow * 2 + (f >> 1)];
#else
    const f16vec2 so = sh_so[lrow * 2 + (f >> 1)];
#endif
#ifdef A_BYTES
    // q8_0: block f >> 1, bytes 16 (f & 1) .. + 15, signed: biased by 128
    const uint base = lrow * QSW + (f >> 1) * 8 + (f & 1) * 4;
    [[unroll]] for (uint i = 0; i < 4; ++i) {
#ifdef TWO_A
        const uint x = (second ? sh_qs2[base + i] : sh_qs[base + i]) ^ 0x80808080u;
#else
        const uint x = sh_qs[base + i] ^ 0x80808080u;
#endif
        const f16vec2 v02 = (bytes02(x) - f16vec2(128.0)) * so.x;
        const f16vec2 v13 = (bytes13(x) - f16vec2(128.0)) * so.x;
        v[4 * i + 0] = v02.x; v[4 * i + 2] = v02.y;
        v[4 * i + 1] = v13.x; v[4 * i + 3] = v13.y;
    }
#else
    // nibbles: bytes 16 (f & 1) .. + 15 of the chunk, low nibble for sub-block 0 (f < 2), high for sub-block 1
    const uint base  = lrow * QSW + (f & 1) * 4;
    const uint shift = (f >> 1) * 4;
#ifdef A_HIGH_BIT
#ifdef TWO_A
    const uint hb = (second ? sh_qh2[lrow * 2 + (f >> 1)] : sh_qh[lrow * 2 + (f >> 1)]) >> ((f & 1) * 16);
#else
    const uint hb = sh_qh[lrow * 2 + (f >> 1)] >> ((f & 1) * 16);
#endif
#endif
    [[unroll]] for (uint i = 0; i < 4; ++i) {
#ifdef TWO_A
        uint x = ((second ? sh_qs2[base + i] : sh_qs[base + i]) >> shift) & 0x0F0F0F0Fu;
#else
        uint x = (sh_qs[base + i] >> shift) & 0x0F0F0F0Fu;
#endif
#ifdef A_HIGH_BIT
        const uint b = hb >> (4 * i);
        x |= ((b & 1u) << 4) | ((b & 2u) << 11) | ((b & 4u) << 18) | ((b & 8u) << 25);
#endif
        const f16vec2 v02 = bytes02(x) * so.x - so.y;
        const f16vec2 v13 = bytes13(x) * so.x - so.y;
        v[4 * i + 0] = v02.x; v[4 * i + 2] = v02.y;
        v[4 * i + 1] = v13.x; v[4 * i + 3] = v13.y;
    }
#endif
}

// ---- fragments and their multiply: coopmat, or the same layout emulated with shuffles

#ifdef EMULATE
#define ACC_PARAM(name) const float name[8]

void frag_mul_add(const float16_t a[16], const uint b_off, inout float acc[8]) {
    const uint lane = gl_SubgroupInvocationID;
    float16_t b[16];
    [[unroll]] for (uint k = 0; k < 16; ++k) {
        b[k] = sh_b[b_off + (lane & 15) * BKP + k];
    }
    [[unroll]] for (uint e = 0; e < 8; ++e) {
        const uint row = (lane >> 4) + 2 * e;
        float s = 0.0;
        [[unroll]] for (uint k = 0; k < 16; ++k) {
            s += subgroupShuffle(float(a[k]), row) * float(b[k]);
        }
        acc[e] += s;
    }
}

void frag_stage(const float acc[8], const uint off) {
    const uint lane = gl_SubgroupInvocationID;
    [[unroll]] for (uint e = 0; e < 8; ++e) {
        sh_c[off + (lane & 15) * 16 + (lane >> 4) + 2 * e] = acc[e];
    }
}
#else
#define ACC_PARAM(name) const coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> name

void frag_stage(const coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc, const uint off) {
    coopMatStore(acc, sh_c, off, 16, gl_CooperativeMatrixLayoutColumnMajor);
}
#endif

// ---- the output. EPI 0: each subgroup stores a 16 rows x 16 tokens fragment through its part of sh_c, element (r, n)
// at n * 16 + r, and writes it as two 64-byte columns a store. EPI 1: straight from the sums, element e of invocation l
// is row (l / 16) + 2 e, token l % 16 of the fragment (coopmat_c_probe.comp checks it; the emulation keeps that layout)

void read_frag(const uint off, out float v[8]) {
    [[unroll]] for (uint i = 0; i < 8; ++i) {
        v[i] = sh_c[off + gl_SubgroupInvocationID + i * WARP];
    }
}

// element i of invocation l: row (l + 32 i) % 16, token (l + 32 i) / 16 of fragment c
void write_frag(const uint c, const uint grow0, const uint tile_count, const float v[8]) {
    [[unroll]] for (uint i = 0; i < 8; ++i) {
        const uint idx = gl_SubgroupInvocationID + i * WARP;
        const uint r   = idx % 16;
        const uint n   = c * 16 + idx / 16;
        if (n < tile_count && grow0 + r < p.M) {
            const u16vec2 ri = row_ids[n];
            float val = v[i];
            if ((p.fusion_flags & 1u) != 0) {
                val *= data_fscale[uint(ri.y) * p.nei0 + uint(ri.x)];
            }
            data_d[uint(ri.y) * p.batch_stride_d + uint(ri.x) * p.stride_d + grow0 + r] = val;
        }
    }
}

// element e of invocation l: row (l / 16) + 2 e, token l % 16 of fragment c
void write_frag_acc(const uint c, const uint grow0, const uint tile_count, const float v[8]) {
    const uint lane = gl_SubgroupInvocationID;
    const uint n    = c * 16 + (lane & 15);
    if (n < tile_count) {
        const u16vec2 ri = row_ids[n];
        const uint base  = uint(ri.y) * p.batch_stride_d + uint(ri.x) * p.stride_d + grow0 + (lane >> 4);
        const bool scale = (p.fusion_flags & 1u) != 0;
        const float s    = scale ? data_fscale[uint(ri.y) * p.nei0 + uint(ri.x)] : 1.0;
        [[unroll]] for (uint e = 0; e < 8; ++e) {
            if (grow0 + (lane >> 4) + 2 * e < p.M) {
                data_d[base + 2 * e] = scale ? v[e] * s : v[e];
            }
        }
    }
}

float silu_mul(const float g, const float u) {
    return g / (1.0 + exp(-g)) * u;
}

// fragment c of the tile: a for the rows of A, a2 for those of the second A
void epilogue(const uint c, const uint grow0, const uint tile_count, ACC_PARAM(a)
#ifdef TWO_A
              , ACC_PARAM(a2)
#endif
              ) {
    const uint c_off = gl_SubgroupID * 256;
    float v[8];
#ifdef GLU_SPLIT
    // the gate in subgroups 0-3, the up projection of the same rows in 4-7: the up fragment goes through sh_c, the gate
    // subgroup writes silu(gate) * up. the barriers are uniform: c < nc_used holds for the whole workgroup
    const uint half_w = BLOCK_SIZE / WARP / 2;
    const bool gate = gl_SubgroupID < half_w;
    if (EPI == 0) {
        frag_stage(a, c_off);
        barrier();
        if (gate) {
            float u[8];
            read_frag(c_off, v);
            read_frag(c_off + half_w * 256, u);
            [[unroll]] for (uint i = 0; i < 8; ++i) {
                v[i] = silu_mul(v[i], u[i]);
            }
            write_frag(c, grow0, tile_count, v);
        }
        barrier();
    } else {
        if (!gate) {
            frag_stage(a, (gl_SubgroupID - half_w) * 256);
        }
        barrier();
        if (gate) {
            const uint lane = gl_SubgroupInvocationID;
            [[unroll]] for (uint e = 0; e < 8; ++e) {
                v[e] = silu_mul(a[e], sh_c[gl_SubgroupID * 256 + (lane & 15) * 16 + (lane >> 4) + 2 * e]);
            }
            write_frag_acc(c, grow0, tile_count, v);
        }
        barrier();
    }
#else
    if (EPI == 0) {
        frag_stage(a, c_off);
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
        read_frag(c_off, v);
#ifdef TWO_A
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
#ifdef FUSED_GLU
        frag_stage(a2, c_off);
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
        float u[8];
        read_frag(c_off, u);
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            v[i] = silu_mul(v[i], u[i]);
        }
        write_frag(c, grow0, tile_count, v);
#else
        write_frag(c, grow0, tile_count, v);
        frag_stage(a2, c_off);
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
        read_frag(c_off, v);
        write_frag(c, grow0 + BM, tile_count, v);
#endif
#else
        write_frag(c, grow0, tile_count, v);
#endif
        controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
    } else {
        [[unroll]] for (uint e = 0; e < 8; ++e) {
            v[e] = a[e];
        }
#if defined(FUSED_GLU)
        [[unroll]] for (uint e = 0; e < 8; ++e) {
            v[e] = silu_mul(v[e], a2[e]);
        }
        write_frag_acc(c, grow0, tile_count, v);
#elif defined(ROWS2)
        write_frag_acc(c, grow0, tile_count, v);
        [[unroll]] for (uint e = 0; e < 8; ++e) {
            v[e] = a2[e];
        }
        write_frag_acc(c, grow0 + BM, tile_count, v);
#else
        write_frag_acc(c, grow0, tile_count, v);
#endif
    }
#endif
}

#ifdef TWO_A
#define TWO_A_ARG(x) , x
#else
#define TWO_A_ARG(x)
#endif

#ifndef EMULATE
// the sums of fragment C named by a constant; the conditions on NC fold at the creation of the pipeline
#ifdef TWO_A
#define ACC_ZERO(C) if (C < NC) { acc[C] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0); \
                                  acc2[C] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0); }
#define MMA2(C) acc2[C] = coopMatMulAdd(ma2, mb, acc2[C]);
#else
#define ACC_ZERO(C) if (C < NC) { acc[C] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0); }
#define MMA2(C)
#endif
#define MMA_C(C) \
                if (C < NC && C < nc_used) { \
                    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb; \
                    coopMatLoad(mb, sh_b, C * 16 * BKP + f * 16, BKP, gl_CooperativeMatrixLayoutColumnMajor); \
                    acc[C] = coopMatMulAdd(ma, mb, acc[C]); \
                    MMA2(C) \
                }
#define EPILOGUE_C(C) if (C < NC && C < nc_used) { epilogue(C, grow0, tile_count, acc[C] TWO_A_ARG(acc2[C])); }
#endif

void main() {
    const uint tid    = gl_LocalInvocationID.x;
    const uint ir     = gl_WorkGroupID.x;
    const uint wave   = gl_SubgroupID;
    const uint lane   = gl_SubgroupInvocationID;

    // the expert and the rows of this tile, from the row map of count_experts.comp
    const uint tile = gl_WorkGroupID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    if (tile >= data_row_map[0]) {
        return;
    }
    const uint expert     = data_row_map[1 + 2 * tile];
    const uint tile_count = data_row_map[2 + 2 * tile];
    const uint ids_base   = p.row_ids_offset + tile * BN;
    for (uint i = tid; i < tile_count; i += BLOCK_SIZE) {
        const uint packed = data_row_map[ids_base + i];
        row_ids[i] = u16vec2(packed & 0xFFFFu, packed >> 16);
    }

    const uint lrow = wave * 16 + (lane & 15);
    const uint nc_used = (tile_count + 15) / 16;

#ifdef EMULATE
    float acc[NC][8];
#ifdef TWO_A
    float acc2[NC][8];
#endif
    [[unroll]] for (uint c = 0; c < NC; ++c) {
        [[unroll]] for (uint e = 0; e < 8; ++e) {
            acc[c][e] = 0.0;
#ifdef TWO_A
            acc2[c][e] = 0.0;
#endif
        }
    }
#else
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[8];
#ifdef TWO_A
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc2[8];
#endif
    ACC_ZERO(0) ACC_ZERO(1) ACC_ZERO(2) ACC_ZERO(3) ACC_ZERO(4) ACC_ZERO(5) ACC_ZERO(6) ACC_ZERO(7)
#endif

    // the row ids before the first B loads
    barrier();
    load_a_tile(0, expert, ir, 0);
#ifdef TWO_A
    load_a_tile(1, expert, ir, 0);
#endif
    if (BPF != 0) {
        load_b_tile(0, tile_count);
    }

    for (uint k0 = 0; k0 < p.K; k0 += BK) {
        barrier();
        write_a_tile(0);
#ifdef TWO_A
        write_a_tile(1);
#endif
        if (BPF == 0) {
            load_b_tile(k0, tile_count); // this stage's own B tile, its registers live only to the store
        }
        write_b_tile();
        barrier();

        // the next stage's loads run while this one computes
        if (k0 + BK < p.K) {
            load_a_tile(0, expert, ir, k0 + BK);
#ifdef TWO_A
            load_a_tile(1, expert, ir, k0 + BK);
#endif
            if (BPF != 0) {
                load_b_tile(k0 + BK, tile_count);
            }
        }

        [[unroll]] for (uint f = 0; f < BK / 16; ++f) {
            float16_t va[16];
            decode_a(false, lrow, f, va);
#ifdef TWO_A
            float16_t va2[16];
            decode_a(true, lrow, f, va2);
#endif
#ifdef EMULATE
            [[unroll]] for (uint c = 0; c < NC; ++c) {
                if (c < nc_used) {
                    const uint b_off = c * 16 * BKP + f * 16;
                    frag_mul_add(va, b_off, acc[c]);
#ifdef TWO_A
                    frag_mul_add(va2, b_off, acc2[c]);
#endif
                }
            }
#else
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
            [[unroll]] for (uint e = 0; e < 16; ++e) { ma[e] = va[e]; }
#ifdef TWO_A
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma2;
            [[unroll]] for (uint e = 0; e < 16; ++e) { ma2[e] = va2[e]; }
#endif
            MMA_C(0) MMA_C(1) MMA_C(2) MMA_C(3) MMA_C(4) MMA_C(5) MMA_C(6) MMA_C(7)
#endif
        }
    }

    const uint grow0 = ir * BMW + wave * 16;
#ifdef EMULATE
    [[unroll]] for (uint c = 0; c < NC; ++c) {
        if (c < nc_used) {
            epilogue(c, grow0, tile_count, acc[c] TWO_A_ARG(acc2[c]));
        }
    }
#else
    EPILOGUE_C(0) EPILOGUE_C(1) EPILOGUE_C(2) EPILOGUE_C(3) EPILOGUE_C(4) EPILOGUE_C(5) EPILOGUE_C(6) EPILOGUE_C(7)
#endif
}
